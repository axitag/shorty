# Database
DATABASE_URL="postgresql://shorty:shortypassword@localhost:5432/shortydb"

# Session
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
SESSION_MAX_AGE_MS=86400000

# Server
PORT=3001
NODE_ENV=development

# CORS - frontend origin
CORS_ORIGIN=http://localhost:5173

# Short code length
SHORT_CODE_LENGTH=7

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Visitor hash rotation secret (privacy-preserving unique visitor estimation)
VISITOR_HASH_SECRET="another-long-random-secret-for-visitor-hashing"
